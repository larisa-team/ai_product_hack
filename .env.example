# Скопируй в .env и при необходимости поправь.
# Значения по умолчанию рассчитаны на docker-compose (хосты postgres/redis).

# --- Инфраструктура ---
CORS_ORIGINS=http://localhost
DEBUG=false

# --- LLM ---
# mock — работает без сети; openai_compat — OpenAI-совместимый эндпоинт
LLM_PROVIDER=mock
# для RouterAI:
#   LLM_PROVIDER=openai_compat
#   LLM_BASE_URL=https://routerai.ru/api/v1
#   LLM_API_KEY=<ключ RouterAI>
#   LLM_MODEL=deepseek/deepseek-v4-flash-0731
# список моделей: curl https://routerai.ru/api/v1/models
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Параметры обработки ---
TG_FETCH_LIMIT=100
TG_FETCH_DAYS=7
FILTER_BATCH=30
NEWSMAKER_CAP=100
NEWSMAKER_BATCH=12
